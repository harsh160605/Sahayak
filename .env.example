# SmartAttend Environment Variables Configuration

# To connect to your live Firebase project, replace the values below with
# your Firebase Console Web App settings:
# Project Settings -> General -> Your apps -> Web app -> SDK setup and configuration

VITE_FIREBASE_API_KEY=AIzaSyDummyKeyForDevelopment
VITE_FIREBASE_AUTH_DOMAIN=smartattend-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=smartattend-dev
VITE_FIREBASE_STORAGE_BUCKET=smartattend-dev.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Firebase Local Emulator Suite (Optional - Set to true if running 'firebase emulators:start')
VITE_USE_FIREBASE_EMULATOR=false

