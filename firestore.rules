rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. Users Profile Collection
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // 2. Courses Collection
    match /courses/{courseId} {
      allow read, write: if isAuthenticated();
    }

    // 3. Enrollments Collection
    match /enrollments/{enrollmentId} {
      allow read, write: if isAuthenticated();
    }

    // 4. Enrollment Requests Collection
    match /enrollmentRequests/{requestId} {
      allow read, write: if isAuthenticated();
    }

    // 5. Attendance Sessions Collection
    match /attendanceSessions/{sessionId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 6. Attendance Records Collection
    match /attendanceRecords/{recordId} {
      allow read, write: if true;
    }

    // 7. Timetable Schedule Collection
    match /timetable/{slotId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 8. Organizations Collection
    // Read is allowed so students & faculty can verify organization codes before registration
    match /organizations/{orgId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 9. Departments Collection
    match /departments/{deptId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 10. Divisions Collection
    match /divisions/{divId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 11. Subject Allocations Collection (Managed by Department Admin)
    match /subjectAllocations/{allocId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
